# Python 執行期產物
__pycache__/
*.py[cod]

# 虛擬環境（由 uv.lock 與 pyproject.toml 重建）
.venv/
.venv313/

# 建置產物（由 WR503-GPST-Monitor.spec 重建）
build/
build313/
dist/

# 沙箱測試的暫存區，只追蹤腳本
sandbox-out/*
!sandbox-out/smoke-test.ps1

# 開發文件與現場資料（只留本機）
docs/

# MR Configurator2 伺服專案（只留本機）
driver/

# MR Configurator2 開啟專案時產生的鎖定檔
*.dup
_dup

# Office 開啟檔案時產生的暫存檔
~$*

# 執行期狀態資料庫
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
